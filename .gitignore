# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
env/
.venv/

# Test and tool caches
.pytest_cache/
.coverage
htmlcov/

# Local data: exclude private/large content, retain documented placeholders.
data/*
!data/raw/
!data/processed/
!data/external/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
!data/default_risk/
data/default_risk/*
!data/default_risk/raw/
!data/default_risk/processed/
!data/default_risk/README.md
data/default_risk/raw/*
!data/default_risk/raw/.gitkeep
data/default_risk/processed/*
!data/default_risk/processed/.gitkeep
data/default_risk/*
!data/default_risk/raw/.gitkeep
!data/default_risk/processed/.gitkeep
!data/default_risk/README.md

# Generated outputs
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
reports/*
!reports/.gitkeep
!reports/data_quality_report.md
!reports/eda_report.md
!reports/eda_insights.md
!reports/preprocessing_report.md
!reports/feature_engineering_report.md
!reports/model_training_report.md
!reports/model_artifact_report.md
!reports/evaluation_report.md
!reports/model_comparison.csv
!reports/model_selection.json
!reports/system_integration_report.md
!reports/phase_8_2_qa_report.md
!reports/default_risk/
logs/*
!logs/.gitkeep

# Generated visualization images (PNG tracked, other formats ignored)
plots/*
!plots/.gitkeep
!plots/*.png

# Local editor settings
.vscode/
